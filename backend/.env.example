DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wu_places?schema=public"
PORT=3000

# --- ระบบผู้ดูแล (Admin) ---
# คีย์ลับสำหรับเซ็นโทเคนล็อกอิน: สุ่มยาวๆ อย่างน้อย 16 ตัวอักษร (เช่นรัน: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="change-me-to-a-long-random-string"
# บัญชีผู้ดูแล: เซิร์ฟเวอร์จะสร้าง/อัปเดตให้อัตโนมัติตอนเริ่มทำงาน (รหัสผ่านอย่างน้อย 8 ตัวอักษร)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-please"
